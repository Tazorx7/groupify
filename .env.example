# ---------------------------------------------------------------------------
# Groupify — example environment. Copy to .env and adjust. Never commit .env.
# ---------------------------------------------------------------------------

# dev | staging | production
# production switches to JSON logs and refuses to run with COOKIE_SECURE=never.
APP_ENV=dev

# --- HTTP ---------------------------------------------------------------
HTTP_ADDR=:8080
# Comma-separated list. Leave empty when the frontend is served through the
# Vite dev proxy (default) or from the same origin in production.
CORS_ORIGINS=
# Set to true only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
# Serve the built SPA from the API (single origin). Leave empty in development:
# the Vite dev server proxies /api instead.
STATIC_DIR=

# --- Database -----------------------------------------------------------
# Local development database (podman container, see Makefile `make db-up`).
DATABASE_URL=postgres://groupify:groupify@127.0.0.1:5433/groupify?sslmode=disable
# Integration tests use this database; it is truncated between tests.
TEST_DATABASE_URL=postgres://groupify:groupify@127.0.0.1:5433/groupify_test?sslmode=disable
AUTO_MIGRATE=true

# --- Admin sessions -----------------------------------------------------
SESSION_TTL=12h
# auto | always | never
#   auto   — Secure whenever the request arrived over HTTPS (directly or via a
#            trusted X-Forwarded-Proto). Plain-HTTP localhost still works, so a
#            production image can be checked on this machine.
#   always — force the flag when TLS terminates somewhere we cannot see.
#   never  — development only; refused when APP_ENV=production.
# In production the session is only ever issued over HTTPS, or to loopback.
COOKIE_SECURE=auto
COOKIE_DOMAIN=

# --- Rate limits (per client IP) ---------------------------------------
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=60

# --- Bootstrap admin (cmd/seed only) -----------------------------------
ADMIN_EMAIL=rep@example.edu
ADMIN_PASSWORD=change-me-please-123
